[Unit]
Description=Ebcotech job & technician app server
After=network.target

[Service]
User=ebcotech
Group=ebcotech
WorkingDirectory=/opt/ebcotech/server
Environment=NODE_ENV=production
Environment=PORT=4000
Environment=HOST=127.0.0.1
Environment=DATA_DIR=/opt/ebcotech/data
Environment=WEB_DIR=/opt/ebcotech/web
Environment=TZ=Asia/Kuala_Lumpur
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
